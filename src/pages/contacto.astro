---
import Base from '@/layouts/Base.astro';import {site,wa} from '@/data/site';
---
<Base title="Contacto | CDA Los Andes" description="Contacta a CDA Los Andes en Ipiales."><section class="pageHero" style="background-image:url('/images/hero-contacto.webp')"><div class="container"><p class="kicker">Hablemos</p><h1>Estamos aquí para orientarte</h1><p>Elige el canal que prefieras para solicitar información.</p></div></section><section class="section section-dark"><div class="container contact reveal"><a href={`tel:${site.phoneHref}`}><span>01</span><small>Teléfono</small><strong>{site.phone}</strong><b>↗</b></a><a href={wa()} target="_blank"><span>02</span><small>WhatsApp</small><strong>Solicitar información</strong><b>↗</b></a><a href={`mailto:${site.email}`}><span>03</span><small>Correo</small><strong>{site.email}</strong><b>↗</b></a></div></section><style>.contact{border-top:1px solid #ffffff25}.contact a{display:grid;grid-template-columns:70px .5fr 1fr 30px;align-items:center;padding:34px 0;border-bottom:1px solid #ffffff25}.contact span{color:var(--green);font-family:var(--display)}.contact small{text-transform:uppercase}.contact strong{font-family:var(--display);font-size:2rem;text-transform:uppercase}.contact b{font-size:1.4rem}@media(max-width:700px){.contact a{grid-template-columns:40px 1fr}.contact strong{grid-column:2;font-size:1.45rem}.contact b{display:none}}</style></Base>
