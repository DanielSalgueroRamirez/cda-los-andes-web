---
import { site, wa } from "@/data/site";
const path = Astro.url.pathname;
const links = [
  ["/", "Inicio"],
  ["/servicios/", "Servicios"],
  ["/sedes/", "Sede"],
  ["/preguntas-frecuentes/", "Preguntas"],
  ["/contacto/", "Contacto"],
];
---

<div class="top">
  <div class="container top__inner">
    <span>📍 {site.city}</span><span>🕒 Horarios sujetos a confirmación</span>
    <span class="phone-desktop">☎ {site.phone}</span>
    <a
      class="phone-mobile"
      href={`tel:${site.phoneHref}`}
      aria-label={`Llamar al ${site.phone}`}
    >
      ☎ {site.phone}
    </a>
  </div>
</div>
<header>
  <div class="container head">
    <a class="brand" href="/" aria-label="CDA Los Andes, inicio"
      ><img
        src="/images/logo-principal-cda-los-andes-transparente.png"
        alt="Logo CDA Los Andes"
        width="1208"
        height="1265"
      /></a
    ><button
      class="menu-button"
      data-menu
      aria-label="Abrir menú"
      aria-expanded="false"><span></span><span></span><span></span></button
    ><nav data-nav aria-label="Navegación principal">
      {
        links.map(([href, label]) => (
          <a
            href={href}
            class:list={{
              active: href === "/" ? path === "/" : path.startsWith(href),
            }}
          >
            {label}
          </a>
        ))
      }<a
        class="btn primary nav-cta"
        href={wa()}
        target="_blank"
        rel="noopener noreferrer">Agendar revisión</a
      >
    </nav>
  </div>
</header>
<script>
  const button = document.querySelector("[data-menu]");
  const nav = document.querySelector("[data-nav]");
  button?.addEventListener("click", () => {
    nav?.classList.toggle("open");
    button.setAttribute(
      "aria-expanded",
      String(nav?.classList.contains("open")),
    );
  });
</script>
<style>
  .top {
    color: #dfe9f4;
    background: #03152d;
    font-size: 0.75rem;
  }
  .top__inner {
    display: flex;
    min-height: 36px;
    align-items: center;
    justify-content: flex-end;
    gap: 24px;
  }
  header {
    position: sticky;
    z-index: 100;
    top: 0;
    border-bottom: 1px solid rgba(3, 21, 45, 0.12);
    background: #fff;
  }
  .head {
    display: flex;
    min-height: 142px;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }
  .brand {
    display: flex;
    width: 455px;
    height: 122px;
    flex: 0 0 455px;
    align-items: center;
    overflow: visible;
  }
  .brand img {
    display: block;
    width: 65%;
    height: 105%;
    object-position: left center;
    mix-blend-mode: normal;
    filter: none;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 27px;
  }
  nav > a:not(.btn) {
    position: relative;
    color: #0b1c30;
    font-family: var(--display);
    font-size: 1.12rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  nav > a:not(.btn):after {
    position: absolute;
    right: 0;
    bottom: -10px;
    left: 0;
    height: 2px;
    background: var(--green);
    content: "";
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s;
  }
  nav > a.active:not(.btn):after,
  nav > a:not(.btn):hover:after {
    transform: scaleX(1);
  }
  .nav-cta {
    white-space: nowrap;
  }
  .menu-button {
    display: none;
    width: 48px;
    height: 48px;
    padding: 11px;
    border: 0;
    background: #eef2f5;
  }
  .menu-button span {
    display: block;
    height: 2px;
    margin: 5px 0;
    background: var(--navy);
  }
  @media (max-width: 1160px) {
    .brand {
      width: 360px;
      height: 104px;
      flex-basis: 360px;
    }
    nav {
      gap: 18px;
    }
    nav > a:not(.btn) {
      font-size: 1rem;
    }
  }
  @media (max-width: 980px) {
    .head {
      min-height: 116px;
    }
    .brand {
      width: 340px;
      height: 100px;
      flex-basis: 340px;
    }
    .menu-button {
      display: block;
    }
    nav {
      position: absolute;
      left: 18px;
      right: 18px;
      top: calc(100% + 8px);
      display: none;
      padding: 22px;
      background: #fff;
      box-shadow: 0 20px 60px rgba(3, 21, 45, 0.2);
      flex-direction: column;
      align-items: stretch;
    }
    nav.open {
      display: flex;
    }
    nav > a:not(.btn) {
      padding: 7px;
    }
  }
  @media (max-width: 560px) {
    .top__inner {
      justify-content: space-between;
      font-size: 0.67rem;
    }
    .top__inner span:nth-child(2) {
      display: none;
    }
    .head {
      min-height: 98px;
    }
    .brand {
      width: min(230px, calc(100vw - 105px));
      height: 84px;
      flex-basis: min(230px, calc(100vw - 105px));
    }
  }
  .phone-desktop {
    display: inline;
  }

  .phone-mobile {
    display: none;
  }

  @media (max-width: 980px) {
    .phone-desktop {
      display: none;
    }

    .phone-mobile {
      display: inline;
    }
  }
</style>
