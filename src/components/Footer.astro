---
import { site } from "@/data/site";
---

<footer>
  <div class="container foot">
    <div class="identity">
      <img src="/images/logo-principal-cda-los-andes.png" alt="CDA Los Andes" />

      <p>Seguridad. Ambiente. Confianza.</p>
    </div>

    <div>
      <b>Navegación</b>

      <a href="/servicios/">Servicios</a>

      <a href="/sedes/">Ubicación</a>
    </div>

    <div>
      <b>Contacto</b>

      <!-- Texto normal para computadores -->
      <span class="phone-desktop">
        {site.phone}
      </span>

      <!-- Enlace para llamar únicamente en celulares -->
      <a
        class="phone-mobile"
        href={`tel:${site.phoneHref}`}
        aria-label={`Llamar a CDA Los Andes al ${site.phone}`}
      >
        {site.phone}
      </a>

      <a href={`mailto:${site.email}`}>
        {site.email}
      </a>

      <span>{site.city}</span>
    </div>
  </div>

  <div class="container legal">
    <span>© {new Date().getFullYear()} CDA Los Andes</span>
    <span>Sitio provisional</span>
  </div>
</footer>

<style>
  footer {
    padding: 72px 0 26px;
    color: #b8c8d8;
    background: #020d1c;
  }

  .foot {
    display: grid;
    grid-template-columns: 1.4fr 0.7fr 1fr;
    gap: 50px;
  }

  .identity {
    min-width: 0;
  }

  .identity img {
    display: block;
    width: 100%;
    max-width: 310px;
    height: 110px;
    object-fit: contain;
    object-position: left center;
    mix-blend-mode: screen;
    transform: none;
  }

  .identity p {
    font-family: var(--display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .foot b {
    display: block;
    margin-bottom: 18px;
    color: #ffffff;
    font-family: var(--display);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .foot a,
  .foot span {
    display: block;
    margin: 8px 0;
  }

  .foot a {
    transition:
      color 0.25s ease,
      transform 0.25s ease;
  }

  .foot a:hover {
    color: #ffffff;
    transform: translateX(4px);
  }

  /*
   * En computador se muestra el número como texto.
   * El enlace telefónico permanece oculto.
   */
  .phone-desktop {
    display: block;
  }

  .phone-mobile {
    display: none !important;
  }

  .legal {
    display: flex;
    justify-content: space-between;
    margin-top: 52px;
    padding-top: 22px;
    border-top: 1px solid #ffffff18;
    font-size: 0.78rem;
  }

  @media (max-width: 720px) {
    .foot {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
    }

    .identity {
      width: 100%;
      min-width: 0;
    }

    .identity img {
      width: 100%;
      max-width: 280px;
      height: auto;
      max-height: 110px;
      margin: 0;
      object-fit: contain;
      object-position: left center;
      transform: none;
    }

    .identity p {
      max-width: 100%;
      font-size: 0.82rem;
      line-height: 1.5;
      overflow-wrap: anywhere;
    }

    .legal {
      gap: 8px;
      flex-direction: column;
    }
  }
</style>
