<a class="whatsapp-float" href={wa('Hola, quiero información sobre la revisión técnico-mecánica en CDA Los Andes.')} target="_blank" rel="noopener noreferrer" aria-label="Escribir a CDA Los Andes por WhatsApp" title="Escribir por WhatsApp"><span aria-hidden="true"></span><svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16 3a12.7 12.7 0 0 0-11 19.1L3.5 28l6.1-1.6A12.8 12.8 0 1 0 16 3Zm0 2.4a10.3 10.3 0 1 1-5.2 19.2l-.8-.5-3.1.8.8-3-.5-.8A10.3 10.3 0 0 1 16 5.4Zm-4.9 5.1c-.3 0-.7.1-1 .5-.4.4-1.3 1.3-1.3 3.1s1.3 3.6 1.5 3.8c.2.3 2.6 4.1 6.5 5.6 3.2 1.3 3.9 1.1 4.6 1 .7-.1 2.2-.9 2.5-1.8.3-.9.3-1.6.2-1.8-.1-.2-.4-.3-.8-.5l-2.6-1.2c-.4-.2-.7-.3-1 .3l-1 1.2c-.3.4-.6.4-1 .2a8.4 8.4 0 0 1-2.5-1.5 9.4 9.4 0 0 1-1.7-2.1c-.2-.4 0-.6.2-.8l.7-.8c.2-.3.3-.5.5-.8.1-.3 0-.6 0-.8l-1.2-2.8c-.3-.8-.7-.8-1-.8h-.6Z"/></svg></a>
<style>.whatsapp-float{position:fixed;z-index:120;right:24px;bottom:24px;display:grid;width:62px;height:62px;place-items:center;border:1px solid rgba(255,255,255,.86);border-radius:50%;color:#fff;background:linear-gradient(145deg,#25d366,#119c50);box-shadow:0 16px 38px rgba(3,21,45,.27),inset 0 1px 0 rgba(255,255,255,.3);transition:transform .22s ease,box-shadow .22s ease}.whatsapp-float:hover{box-shadow:0 20px 48px rgba(3,21,45,.35),0 0 0 7px rgba(37,211,102,.12);transform:translateY(-4px) scale(1.03)}.whatsapp-float:focus-visible{outline:3px solid #fff;outline-offset:4px}.whatsapp-float svg{position:relative;z-index:2;width:34px;height:34px}.whatsapp-float span{position:absolute;inset:-1px;border:1px solid rgba(37,211,102,.44);border-radius:50%;animation:pulse 2.7s ease-out infinite}@keyframes pulse{0%,38%{opacity:0;transform:scale(1)}52%{opacity:.7}100%{opacity:0;transform:scale(1.38)}}@media(prefers-reduced-motion:reduce){.whatsapp-float span{animation:none}}@media(max-width:560px){.whatsapp-float{right:16px;bottom:16px;width:58px;height:58px}.whatsapp-float svg{width:32px;height:32px}}</style>
